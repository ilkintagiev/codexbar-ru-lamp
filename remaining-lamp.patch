diff --git a/Sources/CodexBar/StatusItemController+RemainingLamp.swift b/Sources/CodexBar/StatusItemController+RemainingLamp.swift
new file mode 100644
index 0000000..bc83494
--- /dev/null
+++ b/Sources/CodexBar/StatusItemController+RemainingLamp.swift
@@ -0,0 +1,57 @@
+import AppKit
+import CodexBarCore
+
+extension StatusItemController {
+    func applyRemainingLamp(provider: UsageProvider, button: NSStatusBarButton) -> Bool {
+        let snapshot = self.store.menuBarSnapshot(for: provider.instanceID)
+        // Codex must use the account's explicit seven-day lane, never a scoped model lane.
+        let window = provider == .codex
+            ? RemainingLamp.weekly(primary: snapshot?.primary, secondary: snapshot?.secondary)
+            : self.menuBarMetricWindow(for: provider, snapshot: snapshot)
+        let stale = self.store.isStale(provider: provider) || RemainingLamp.isExpired(updatedAt: snapshot?.updatedAt)
+        let percent = RemainingLamp.percent(window: window, stale: stale)
+        let color: NSColor = switch RemainingLamp.level(percent: percent) {
+        case .green: .systemGreen
+        case .yellow: .systemYellow
+        case .red: .systemRed
+        case .unknown: .systemGray
+        }
+        let image = NSImage(size: NSSize(width: 12, height: 18), flipped: false) { _ in
+            color.setFill()
+            NSBezierPath(ovalIn: NSRect(x: 2, y: 5, width: 8, height: 8)).fill()
+            return true
+        }
+        image.isTemplate = false
+        button.image = image
+        button.imagePosition = .imageLeft
+        button.title = percent.map { " \(Int($0.rounded()))%" } ?? " —"
+        button.toolTip = nil
+        return true
+    }
+}
+
+enum RemainingLamp {
+    enum Level { case green, yellow, red, unknown }
+
+    static func isExpired(updatedAt: Date?, now: Date = .init()) -> Bool {
+        guard let updatedAt else { return true }
+        let age = now.timeIntervalSince(updatedAt)
+        return age > 300 || age < -60
+    }
+
+    static func weekly(primary: RateWindow?, secondary: RateWindow?) -> RateWindow? {
+        [primary, secondary].compactMap(\.self).first { $0.windowMinutes == 10080 }
+    }
+
+    static func percent(window: RateWindow?, stale: Bool) -> Double? {
+        guard !stale, let window, !window.isSyntheticPlaceholder, window.usedPercent.isFinite else { return nil }
+        return min(100, max(0, 100 - window.usedPercent))
+    }
+
+    static func level(percent: Double?) -> Level {
+        guard let percent else { return .unknown }
+        if percent > 30 { return .green }
+        if percent >= 15 { return .yellow }
+        return .red
+    }
+}
