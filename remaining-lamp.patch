diff --git a/Tests/CodexBarTests/RemainingLampTests.swift b/Tests/CodexBarTests/RemainingLampTests.swift
new file mode 100644
index 0000000..29c87ba
--- /dev/null
+++ b/Tests/CodexBarTests/RemainingLampTests.swift
@@ -0,0 +1,26 @@
+import CodexBarCore
+import Foundation
+import Testing
+@testable import CodexBar
+
+struct RemainingLampTests {
+    @Test func thresholdsAndUnknown() {
+        #expect(RemainingLamp.level(percent: 31) == .green)
+        #expect(RemainingLamp.level(percent: 30) == .yellow)
+        #expect(RemainingLamp.level(percent: 15) == .yellow)
+        #expect(RemainingLamp.level(percent: 14) == .red)
+        #expect(RemainingLamp.level(percent: nil) == .unknown)
+        let weekly = RateWindow(usedPercent: 24, windowMinutes: 10080, resetsAt: nil, resetDescription: nil)
+        let short = RateWindow(usedPercent: 95, windowMinutes: 300, resetsAt: nil, resetDescription: nil)
+        #expect(RemainingLamp.weekly(primary: short, secondary: weekly) == weekly)
+        #expect(RemainingLamp.weekly(primary: weekly, secondary: short) == weekly)
+        #expect(RemainingLamp.weekly(primary: short, secondary: nil) == nil)
+        #expect(RemainingLamp.percent(window: weekly, stale: false) == 76)
+        #expect(RemainingLamp.percent(window: weekly, stale: true) == nil)
+        #expect(RemainingLamp.percent(window: nil, stale: false) == nil)
+        let now = Date(timeIntervalSince1970: 1000)
+        #expect(!RemainingLamp.isExpired(updatedAt: now.addingTimeInterval(-60), now: now))
+        #expect(RemainingLamp.isExpired(updatedAt: now.addingTimeInterval(-301), now: now))
+        #expect(RemainingLamp.isExpired(updatedAt: nil, now: now))
+    }
+}
