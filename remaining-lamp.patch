+import importlib.util,tempfile,unittest,zipfile
+from pathlib import Path
+from unittest.mock import patch
+s=importlib.util.spec_from_file_location('u',Path(__file__).parents[1]/'Sources/CodexBar/Resources/cloud_update.py');u=importlib.util.module_from_spec(s);s.loader.exec_module(u)
+class Tests(unittest.TestCase):
+ def fixture(self):
+  manifest=dict(repository=u.REPO,platform='arm64',recipeSHA='a'*40,archiveSHA256='b'*64,upstreamTag='v0.72.0',upstreamCommit='c'*40)
+  run=dict(conclusion='success',status='completed',head_sha='a'*40,head_repository=dict(full_name=u.REPO),path='.github/workflows/build.yml')
+  jobs={'jobs':[{'conclusion':'success','steps':[dict(name=n,conclusion='success') for n in u.REQUIRED]}]}
+  return manifest,run,jobs
+ def test_manifest_gates(self):
+  a,b,c=self.fixture();u.validate_manifest(a,b,c)
+  b['conclusion']='failure'
+  with self.assertRaises(ValueError):u.validate_manifest(a,b,c)
+  a,b,c=self.fixture();c['jobs'][0]['steps'][1]['conclusion']='skipped'
+  with self.assertRaises(ValueError):u.validate_manifest(a,b,c)
+ def test_same_recipe_new_upstream_is_new_build(self):
+  a,_,_=self.fixture();b=dict(a,upstreamCommit='d'*40,upstreamTag='v0.73.0')
+  self.assertNotEqual(u.build_identity(a),u.build_identity(b))
+ def test_interrupted_rename_retains_good_copy(self):
+  with tempfile.TemporaryDirectory() as d:
+   root=Path(d);app=root/'CodexBar.app';rollback=root/'CodexBar.rollback.app';backup=root/'CodexBar.previous.app'
+   backup.mkdir();(backup/'good').write_text('previous')
+   u.recover_interrupted(app,rollback,backup)
+   self.assertEqual((app/'good').read_text(),'previous')
+   rollback.mkdir();(rollback/'good').write_text('interrupted')
+   with self.assertRaises(RuntimeError):u.recover_interrupted(app,rollback,backup)
+   self.assertTrue(app.exists());self.assertTrue(rollback.exists())
+ def test_failed_new_start_restores_previous_and_restarts(self):
+  with tempfile.TemporaryDirectory() as d:
+   root=Path(d);app=root/'CodexBar.app';candidate=root/'candidate'
+   app.mkdir();(app/'identity').write_text('old');candidate.mkdir();(candidate/'identity').write_text('new')
+   calls=[]
+   def command(args,timeout=60):calls.append(args);return b''
+   with patch.object(u,'APP',app),patch.object(u,'command',command),patch.object(u,'job_process',side_effect=[10,None,None]),patch.object(u,'wait_stopped'),patch.object(u,'verify_new_process',side_effect=RuntimeError('new process failed')),patch.object(u.time,'sleep'):
+    with self.assertRaises(RuntimeError):u.replace_app(candidate)
+   self.assertEqual((app/'identity').read_text(),'old')
+   self.assertEqual(sum('kickstart' in c for c in calls),2)
+   self.assertFalse(app.with_name('CodexBar.rollback.app').exists())
+ def test_interruption_restores_rollback_before_rotation(self):
+  with tempfile.TemporaryDirectory() as d:
+   root=Path(d);app=root/'CodexBar.app';rollback=root/'CodexBar.rollback.app';backup=root/'CodexBar.previous.app'
+   rollback.mkdir();(rollback/'identity').write_text('current-good');backup.mkdir();(backup/'identity').write_text('older-good')
+   u.recover_interrupted(app,rollback,backup)
+   self.assertEqual((app/'identity').read_text(),'current-good')
+   self.assertEqual((backup/'identity').read_text(),'older-good')
+ def test_old_process_never_exits_bundle_is_retained(self):
+  with tempfile.TemporaryDirectory() as d:
+   app=Path(d)/'CodexBar.app';candidate=Path(d)/'candidate';app.mkdir();candidate.mkdir();(app/'identity').write_text('old')
+   with patch.object(u,'APP',app),patch.object(u,'command',return_value=b''),patch.object(u,'job_process',return_value=10),patch.object(u,'wait_stopped',side_effect=TimeoutError('still running')):
+    with self.assertRaises(TimeoutError):u.replace_app(candidate)
+   self.assertEqual((app/'identity').read_text(),'old')
+ def test_old_pid_is_not_new_build_health(self):
+  with patch.object(u,'job_process',return_value=10):
+   with self.assertRaises(RuntimeError):u.verify_new_process(10)
+ def test_zip_rejects_escape(self):
+  with tempfile.TemporaryDirectory() as d:
+   p=Path(d)/'archive.zip'
+   with zipfile.ZipFile(p,'w') as z:z.writestr('CodexBar.app/Contents/Info.plist','fixture')
+   u.validate_zip(p)
+   with zipfile.ZipFile(p,'w') as z:z.writestr('../escape','bad')
+   with self.assertRaises(ValueError):u.validate_zip(p)
+if __name__=='__main__':unittest.main()
