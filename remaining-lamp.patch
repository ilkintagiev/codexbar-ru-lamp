+p=argparse.ArgumentParser();p.add_argument('--upstream-tag',required=True);p.add_argument('--upstream-commit',required=True);p.add_argument('--recipe-sha',required=True);p.add_argument('--run-id',required=True,type=int);p.add_argument('--resources',required=True);p.add_argument('--archive');p.add_argument('--channel-enabled',action='store_true');a=p.parse_args()
